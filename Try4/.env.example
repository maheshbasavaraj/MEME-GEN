OPENROUTER_API_KEY=your_openrouter_key
OPENROUTER_MODEL=openrouter/free
# Optional: searches for broadly relevant meme references before captioning.
TAVILY_API_KEY=
IMGFLIP_USERNAME=your_imgflip_username
IMGFLIP_PASSWORD=your_imgflip_password
TRANSCRIBER_MODEL=distil-whisper/distil-large-v3-openai
TRANSCRIBER_DEVICE=auto
# Leave blank to use Windows' default microphone. Run `python main.py --list-mics`
# and set this to the chosen input-device index when the default is wrong.
MIC_DEVICE_INDEX=
# Optional: course vocabulary, e.g. NumPy, PyTorch, gradient descent
TRANSCRIBER_HOTWORDS=
